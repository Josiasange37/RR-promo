# Public Cloudinary delivery configuration. The cloud name is safe to expose.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Upload this asset in Cloudinary with this public ID, or replace it with yours.
NEXT_PUBLIC_CLOUDINARY_HERO_IMAGE=nb-dance/hero

# Optional second image, revealed inside the cursor spotlight in the hero.
# Falls back to a stock dance image when unset.
NEXT_PUBLIC_CLOUDINARY_REVEAL_IMAGE=nb-dance/reveal

# Never put CLOUDINARY_API_SECRET or CLOUDINARY_URL in a NEXT_PUBLIC_ variable.

# ── Supabase (required) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Secret admin panel ──────────────────────────────────────
# Long random hash used as the hidden URL: /admin/<ADMIN_SLUG>
ADMIN_SLUG=replace_with_a_long_random_hash
