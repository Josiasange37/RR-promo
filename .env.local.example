NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_HERO_IMAGE=nb-dance/hero
NEXT_PUBLIC_CLOUDINARY_REVEAL_IMAGE=nb-dance/reveal

# ── Supabase (required) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Secret admin panel ──────────────────────────────────────
# Long random hash used as the hidden URL: /admin/<ADMIN_SLUG>
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SLUG=replace_with_a_long_random_hash

# ── CamerPay (payment gateway) ──────────────────────────────
# API token from your CamerPay dashboard (API & webhooks).
# Set to empty to run in sandbox mode (simulated payments).
CAMERPAY_TOKEN=your_api_token
# HMAC-SHA256 webhook verification secret. Required for production.
CAMERPAY_CALLBACK_SECRET=your_callback_secret
# development | production
CAMERPAY_MODE=development
# Public base URL (no trailing slash) used for the payment callback/return URLs.
# REQUIRED for production: CamerPay rejects callback URLs pointing at localhost.
CAMERPAY_PUBLIC_URL=https://mon-site.vercel.app